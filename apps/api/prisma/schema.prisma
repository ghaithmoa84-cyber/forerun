generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  whatsapp        String            @unique
  altPhone        String?
  passwordHash    String
  name            String
  role            UserRole
  status          UserStatus        @default(PENDING_VERIFICATION)
  isDeleted       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  admin           Admin?
  auditLogs       AuditLog[]
  customer        Customer?
  cancelledOrders Order[]           @relation("CancelledByUser")
  PlatformPricing PlatformPricing[]
  deviceTokens  DeviceToken[]
  refreshTokens   RefreshToken[]
  runner          Runner?

  @@index([whatsapp])
  @@index([role, status])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("DeviceToken")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  selector   String    @unique
  tokenHash  String    @unique
  deviceInfo String?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, isRevoked])
}

model Customer {
  id              String           @id @default(cuid())
  userId          String           @unique
  completedOrders Int              @default(0)
  totalFeesPaid   Int              @default(0)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id])
  address         CustomerAddress?
  orders          Order[]
  ratings         Rating[]
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String   @unique
  lat         Float
  lng         Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
}

model Runner {
  id                String        @id @default(cuid())
  userId            String        @unique
  status            RunnerStatus  @default(UNAVAILABLE)
  isVisible         Boolean       @default(true)
  avgRating         Float?
  totalRatings      Int           @default(0)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  ledgerEntries     LedgerEntry[]
  preferredInOrders Order[]       @relation("PreferredRunner")
  orders            Order[]
  ratings           Rating[]
  user              User          @relation(fields: [userId], references: [id])
  settlements       Settlement[]

  @@index([status, isVisible])
}

model Admin {
  id          String       @id @default(cuid())
  userId      String       @unique
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  settlements Settlement[]
  banners     Banner[]
}

model Order {
  id                String          @id @default(cuid())
  seqNumber         Int             @unique @default(autoincrement())
  orderNumber       String?         @unique
  customerId        String
  runnerId          String?
  status            OrderStatus     @default(DRAFT)
  deliveryLat       Float
  deliveryLng       Float
  deliveryDesc      String
  isPeripheral      Boolean         @default(false)
  baseFee           Int             @default(60)
  peripheralFee     Int             @default(0)
  extraStoresFee    Int             @default(0)
  totalFee          Int             @default(60)
  preferredRunnerId String?
  waitForPreferred  Boolean         @default(false)
  notes             String?
  cancelReason      String?
  cancelledByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reviewedAt        DateTime?
  assignedAt        DateTime?
  startedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  idempotencyKey    String?         @unique
  customFee         Int             @default(0)
  customFeeReason   String?
  auditLogs         AuditLog[]
  ledgerEntries     LedgerEntry[]
  cancelledByUser   User?           @relation("CancelledByUser", fields: [cancelledByUserId], references: [id])
  customer          Customer        @relation(fields: [customerId], references: [id])
  preferredRunner   Runner?         @relation("PreferredRunner", fields: [preferredRunnerId], references: [id])
  runner            Runner?         @relation(fields: [runnerId], references: [id])
  items             OrderItem[]
  orderStores       OrderStore[]
  ratings           Rating[]
  settlementItem    SettlementItem?

  @@index([customerId, status])
  @@index([runnerId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  itemName        String
  quantity        String
  customStoreName String?
  anyStore        Boolean     @default(true)
  orderStoreId    String?
  isCancelled     Boolean     @default(false)
  cancelNote      String?
  createdAt       DateTime    @default(now())
  order           Order       @relation(fields: [orderId], references: [id])
  orderStore      OrderStore? @relation(fields: [orderStoreId], references: [id])

  @@index([orderId])
}

model OrderStore {
  id          String           @id @default(cuid())
  orderId     String
  storeName   String
  isAnyStore  Boolean          @default(false)
  status      OrderStoreStatus @default(PENDING)
  isExtra     Boolean          @default(false)
  addedBy     String?
  purchasedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  items       OrderItem[]
  order       Order            @relation(fields: [orderId], references: [id])
  receipts    Receipt[]

  @@index([orderId, status])
  @@index([orderId, isDeleted])
}

model Receipt {
  id           String     @id @default(cuid())
  orderStoreId String
  imageUrl     String
  r2Key        String
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  uploadedAt   DateTime   @default(now())
  orderStore   OrderStore @relation(fields: [orderStoreId], references: [id])
}

model Rating {
  id             String   @id @default(cuid())
  orderId        String
  customerId     String
  runnerId       String?
  storeNameRated String?
  stars          Int
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime
  isFinal        Boolean  @default(false)
  customer       Customer @relation(fields: [customerId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])
  runner         Runner?  @relation(fields: [runnerId], references: [id])

  @@unique([orderId, customerId])
  @@unique([orderId, runnerId])
  @@index([orderId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  orderId     String?
  runnerId    String?
  type        LedgerEntryType
  amount      Int
  description String
  meta        Json?
  createdAt   DateTime        @default(now())
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  runner      Runner?         @relation(fields: [runnerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([runnerId, type])
  @@index([createdAt])
}

model Settlement {
  id              String           @id @default(cuid())
  runnerId        String
  operationalDate String           @db.VarChar(10)
  status          SettlementStatus @default(PENDING)
  totalOrders     Int
  totalFees       Int
  runnerShare     Int
  platformShare   Int
  notes           String?
  closedAt        DateTime?
  closedByAdminId String?
  createdAt       DateTime         @default(now())
  closedByAdmin   Admin?           @relation(fields: [closedByAdminId], references: [id])
  runner          Runner           @relation(fields: [runnerId], references: [id])
  items           SettlementItem[]

  @@unique([runnerId, operationalDate])
  @@index([status, operationalDate])
}

model SettlementItem {
  id            String     @id @default(cuid())
  settlementId  String
  orderId       String     @unique
  orderFee      Int
  runnerShare   Int
  platformShare Int
  order         Order      @relation(fields: [orderId], references: [id])
  settlement    Settlement @relation(fields: [settlementId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  orderId    String?
  actorId    String?
  actorRole  String?
  event      String
  fromStatus String?
  toStatus   String?
  meta       Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([event, createdAt])
}

model PlatformPricing {
  id              String   @id @default("default")
  baseFee         Int
  extraStoreFee   Int
  peripheralFee   Int
  updatedAt       DateTime @default(now())
  updatedByUserId String?
  User            User?    @relation(fields: [updatedByUserId], references: [id])
}

enum UserRole {
  CUSTOMER
  RUNNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RunnerStatus {
  AVAILABLE
  ON_MISSION
  UNAVAILABLE
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  AWAITING_RUNNER
  AWAITING_PREFERRED_RUNNER
  ASSIGNED
  IN_PROGRESS
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderStoreStatus {
  PENDING
  PURCHASED
  SKIPPED
}

enum LedgerEntryType {
  ORDER_FEE_TOTAL
  RUNNER_SHARE
  PLATFORM_SHARE
  SETTLEMENT_PAID
  ADMIN_ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  SETTLED
}

model Banner {
  id               String           @id @default(cuid())
  title            String
  headline         String?
  subtitle         String?
  imageUrl         String
  actionType       BannerActionType @default(NONE)
  actionValue      String?
  ctaLabel         String?
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  isDeleted        Boolean          @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  createdByAdminId String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        Admin            @relation(fields: [createdByAdminId], references: [id])

  @@index([isDeleted, isActive, sortOrder])
}

enum BannerActionType {
  NONE
  EXTERNAL_URL
  IN_APP_ROUTE
  WHATSAPP_ADMIN
}
